{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "rewrites": [
    { "source": "/(.*)", "destination": "/server.js" }
  ],
  "functions": {
    "server.js": {
      "includeFiles": [
        "client/**",
        "webapis/**",
        "favicon.ico",
        "favicon.svg",
        "index.html"
      ]
    }
  }
}
